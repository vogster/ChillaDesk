# --- docker compose ---
# Required: password for the bundled PostgreSQL. It is embedded in a connection URL,
# so use only letters, digits, '-' and '_' (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me
# Host port the web UI is published on.
CHILLADESK_PORT=8080
# Set to true when you serve ChillaDesk over HTTPS through your own reverse proxy,
# so the session cookie is never sent over plain HTTP.
# COOKIE_SECURE=auto

# --- API (local development) ---
# Leave DATABASE_URL unset to use the embedded PGlite database in PGLITE_DATA_DIR.
# DATABASE_URL=postgres://chillawiki:change-me@localhost:5432/chillawiki
# PGLITE_DATA_DIR=./.data/pglite
# HOST=0.0.0.0
# PORT=3000
# Number of reverse proxies in front of the API (docker compose sets 1 for you).
# TRUST_PROXY=false
# Who may sign up: true (anyone), invite (only with an invite link, which also joins its
# project) or false (nobody).
# REGISTRATION_ENABLED=true
# Requests per minute allowed from one address. People behind the same NAT share it.
# RATE_LIMIT_MAX=600
LOG_LEVEL=info

# Where attached files are kept (docker compose uses a volume) and how large one may be.
# FILES_DIR=./.data/files
# MAX_UPLOAD_MB=10
# How much room the files of one project may take up together, in megabytes.
# PROJECT_FILES_MB=1024

# --- Email notifications (optional) ---
# Without SMTP_URL notifications are shown in the app only. All three go together.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=ChillaDesk <wiki@example.com>
# The address people open ChillaDesk at; links in emails and webhook messages point there.
# It is used for webhooks even without email.
# PUBLIC_URL=https://wiki.example.com

# --- Webhooks ---
# Webhooks cannot reach private addresses (this server, your LAN, cloud metadata) unless
# this is true. Turn it on only if you trust every project owner on this server.
# WEBHOOKS_ALLOW_PRIVATE=false

# --- Images ---
# Which released version `docker compose pull` fetches (e.g. 0.2.0, or 0.2 for its fixes).
# CHILLADESK_VERSION=latest
# Where the images come from, if you publish your own builds.
# CHILLADESK_IMAGE_PREFIX=ghcr.io/vogster/chilladesk
